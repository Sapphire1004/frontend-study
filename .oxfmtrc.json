{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./frontend/src/style.css"
  },
  "ignorePatterns": ["node_modules/**", ".pnpm-store/**", "dist/**", ".bench/**"]
}
